// Prisma schema for Toolhaven
// Run: npx prisma migrate dev --name init  &&  npm run seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  name         String
  description  String?
  iconKey      String?   // maps to a lucide icon name on the frontend
  colorPrimary String    @default("#7C3AED")
  colorAccent  String    @default("#00F5FF")
  orderDisplay Int       @default(0)
  createdAt    DateTime  @default(now())

  tools         Tool[]
  subcategories Subcategory[]
  blogPosts     BlogPost[]
  bestLists     BestList[]
  clicks        AffiliateClick[]
  buyingGuides BuyingGuide[]
}

model Subcategory {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tools      Tool[]
  createdAt  DateTime @default(now())
}

model Tool {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  description     String   // short, 1-2 sentences
  fullDescription String?  // the persuasive pitch
  bestFor         String?
  caveat          String?
  logoMono        String?  // monogram fallback for the logo tile
  logoUrl         String?  // official brand asset, served from the vendor's own domain
  logoAlt         String?  // accessible name, e.g. "Make logo"
  websiteUrl      String?
  affiliateLink   String?
  affiliateNetwork String?
  priceMin        Float    @default(0)
  priceMax        Float    @default(0)
  priceType       String   @default("freemium") // free | freemium | paid | subscription
  freeTrial       Boolean  @default(false)
  freeTier        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  popularity      Int      @default(0)
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id])
  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  features     ToolFeature[]
  reviews      ToolReview[]
  testimonials Testimonial[]
  pros         ToolPro[]
  clicks       AffiliateClick[]
  blogMentions BlogPostTool[]
  bestEntries  BestListEntry[]
  score        ToolScore?
  facts        ToolFact[]
  externalRatings ExternalRating[]
  verdict      ToolVerdict?
  alternatives ToolAlternative[] @relation("AlternativesFor")
  alternativeTo ToolAlternative[] @relation("AlternativeOf")
  partnerId    Int?
  partner      Partner?  @relation(fields: [partnerId], references: [id])

  pricing        ToolPricing?
  pricingHistory ToolPricingHistory[]
  pricingLogs    PricingVerificationLog[]
}

model ToolPro {
  id     Int    @id @default(autoincrement())
  toolId Int
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  text   String
}

model ToolFeature {
  id          Int    @id @default(autoincrement())
  toolId      Int
  tool        Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  featureName String
  description String?
}

model ToolReview {
  id         Int      @id @default(autoincrement())
  toolId     Int
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  authorName String?  // reader's display name (optional)
  title      String
  content    String
  rating     Float
  useCase    String?
  helpful    Int      @default(0)        // "was this helpful?" tally
  status     String   @default("approved") // approved | pending — reader reviews come in pending
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  toolId    Int?
  tool      Tool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  userName  String
  userTitle String?
  content   String
  rating    Float    @default(5)
  createdAt DateTime @default(now())
}

model BlogPost {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  excerpt       String
  content       String   // markdown
  featuredImage String?
  author        String   @default("Toolhaven")
  readTime      Int      @default(5)
  isPublished   Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  toolLinks  BlogPostTool[]
}

model BlogPostTool {
  id           Int      @id @default(autoincrement())
  blogPostId   Int
  blogPost     BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  toolId       Int
  tool         Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  mentionOrder Int      @default(0)
}

model AffiliateClick {
  id           Int      @id @default(autoincrement())
  toolId       Int
  tool         Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id])
  userIp       String?
  userAgent    String?
  referrerPage String?
  createdAt    DateTime @default(now())
}

model NewsletterSubscriber {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  name               String?
  preferredCategories String[]
  subscribedAt       DateTime  @default(now())
  unsubscribedAt     DateTime?
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  messageType String  @default("general")
  message   String
  createdAt DateTime @default(now())
}

// Readers sharing the tools they actually use — community social proof.
model Stack {
  id         Int      @id @default(autoincrement())
  authorName String?
  authorRole String?
  note       String?  // why this stack / how they use it
  toolSlugs  String[] // the tools in the stack, by slug
  status     String   @default("pending") // pending | approved
  createdAt  DateTime @default(now())
}

// ── The Toolhaven Score ──────────────────────────────────────────────────
// An editorial assessment across six dimensions, entered by hand for tools we
// have actually sat down with. Every field is nullable and the row is optional:
// a tool without a score shows no score, rather than a number nobody produced.
//
// The overall figure is deliberately NOT stored. It is the mean of whichever
// dimensions are filled in, computed on read, so it can never drift out of step
// with its own parts — the classic failure of a cached aggregate.
//
// This is separate from `Tool.rating`, which is the community's star average.
// They answer different questions and are labelled differently in the UI: this
// is our verdict, that is what readers report.
model ToolScore {
  id     Int  @id @default(autoincrement())
  toolId Int  @unique
  tool   Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  features      Float? // depth where it matters for the job
  easeOfUse     Float? // time from signup to actually productive
  performance   Float? // speed and behaviour under real load
  value         Float? // what you get for the money, against the free tier
  devExperience Float? // docs, API, integrations, escape hatches
  support       Float? // can you solve your own problem at 2am

  notes    String? // why these numbers — shown with the score, not hidden
  scoredBy String? // who made the call
  scoredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Best-of lists ────────────────────────────────────────────────────────
// The editorial listicle: "Best accounting software for small businesses".
// These are the pages that answer commercial-intent searches, and the reason
// they are modelled rather than written as blog markdown is that every entry
// points at a real Tool row. Price, rating and the catch are therefore read
// live from the tool itself — a list published in March cannot still be quoting
// March's pricing in September, and the comparison table cannot drift out of
// step with the tool pages it links to.
model BestList {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // "accounting-software" → /best/accounting-software
  title       String
  subtitle    String?  // the deck under the headline
  intro       String   // markdown: what this list covers
  audience    String?  // "who this is for", stated plainly
  criteria    String?  // markdown: how the picks were chosen
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  entries BestListEntry[]
  faqs    BestListFaq[]
}

// One tool's place in a list. `award` is the reason it's here ("Best overall",
// "Best free tier"); `blurb` is the editorial note for this list specifically,
// distinct from the tool's own description.
model BestListEntry {
  id         Int      @id @default(autoincrement())
  bestListId Int
  bestList   BestList @relation(fields: [bestListId], references: [id], onDelete: Cascade)
  toolId     Int
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  rank       Int      @default(0)
  award      String?
  blurb      String?

  @@unique([bestListId, toolId])
}

model BestListFaq {
  id         Int      @id @default(autoincrement())
  bestListId Int
  bestList   BestList @relation(fields: [bestListId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  orderIndex Int      @default(0)
}

// Vendors submitting their tool to be considered for an (honest) review.
//
// The extra fields below are the ones a reviewer would otherwise have to go and
// find: what it does, who it's for, what it actually costs. Asking once, at
// submission, is the difference between a queue that can be worked through and
// a queue of links needing research. All of them are optional — a thin
// submission is still a submission, it just waits longer.
model ToolSubmission {
  id               Int      @id @default(autoincrement())
  toolName         String
  websiteUrl       String
  category         String?
  pricing          String?  // free | freemium | paid | subscription
  affiliateProgram String?  // PartnerStack | Impact | Other | None
  contactName      String
  email            String
  pitch            String   // one-line pitch
  details          String?  // longer context

  // what it is
  description    String?
  logoUrl        String?
  features       String[] // key features, one per line
  useCases       String[] // "what people use it for", one per line
  targetAudience String?

  // who's behind it — context for the reviewer, and how to follow up
  companyName String?
  socialLinks String[] // X, LinkedIn, GitHub…
  screenshots String[] // image URLs

  // The review workflow.
  //
  // "approved" and "published" are deliberately separate states. Approving is a
  // judgement — this belongs on the site; publishing is an act — it is on the
  // site now. Collapsing them means an editor cannot say yes to a tool while
  // still writing the entry, and it makes "your tool is live" a lie for however
  // long that takes.
  //
  //   pending → under_review → approved → published
  //                         ↘ changes_requested → (resubmitted) → pending
  //                         ↘ declined
  status String @default("pending")

  // Timestamps per transition rather than one mutable field, so the history is
  // legible from the row itself and cannot be overwritten by the next change.
  submittedAt      DateTime  @default(now())
  reviewStartedAt  DateTime?
  approvedAt       DateTime?
  publishedAt      DateTime?
  declinedAt       DateTime?
  changesRequestedAt DateTime?
  lastStatusChange DateTime  @default(now())

  reviewerNote     String?   // internal, never leaves the admin
  submitterMessage String?   // sent to them verbatim in the status email
  resubmitCount    Int       @default(0)

  // An unguessable handle for the status page. Toolhaven has no accounts, so
  // this is what lets a submitter check on their own submission — the link goes
  // out in the receipt email and is the only way in.
  publicToken String? @unique

  // Set once the submission becomes a real listing, so the two stop being
  // separate stories the moment they are the same thing.
  publishedToolId Int?

  logoUploadId Int?
  logoUpload   Upload? @relation(fields: [logoUploadId], references: [id])

  events     SubmissionEvent[]
  emailEvents EmailEvent[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

/// A file held in the database.
///
/// Render's filesystem is ephemeral — anything written to disk is gone on the
/// next deploy — and Toolhaven has no object storage. Logos are small and few,
/// so they live here as bytes and are served by the API with long cache
/// headers. If this ever outgrows Postgres, the serving URL stays the same and
/// only the storage behind it changes.
model Upload {
  id        Int      @id @default(autoincrement())
  data      Bytes
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  filename  String?
  // Identical bytes are stored once. A resubmitted logo is usually the same
  // file, and this makes replacing one free.
  sha256    String   @unique
  createdAt DateTime @default(now())

  submissions ToolSubmission[]
  guideOgImages BuyingGuide[] @relation("GuideOgImage")
  guidePickImages GuidePick[] @relation("GuidePickImage")
  guidePickPhotos GuidePickPhoto[]

  @@index([createdAt])
}

/// The audit trail. Append-only: a row is written for every transition, so
/// "when did this change and who moved it" is answerable long after the fact.
model SubmissionEvent {
  id           Int            @id @default(autoincrement())
  submissionId Int
  submission   ToolSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  type       String   // created | status-changed | resubmitted | published | note-added
  fromStatus String?
  toStatus   String?
  actor      String   @default("editor") // editor | submitter | system
  detail     String?
  createdAt  DateTime @default(now())

  @@index([submissionId, createdAt])
}

/// Every automated email, recorded before it is trusted.
///
/// The point is the unique constraint: one send per submission per event. A
/// double-clicked Approve button, a retried request or a redeploy mid-flight
/// would otherwise mail the same person twice, and a system that repeats itself
/// reads as broken no matter how good the message is.
model EmailEvent {
  id           Int            @id @default(autoincrement())
  submissionId Int
  submission   ToolSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  eventType String   // received | under-review | approved | published | changes-requested | declined
  recipient String
  status    String   @default("sent") // sent | failed
  messageId String?
  error     String?
  sentAt    DateTime @default(now())

  // Only successful sends occupy the slot; a failure is recorded and can be
  // retried, which is why this is not simply @@unique([submissionId, eventType]).
  @@unique([submissionId, eventType, status])
  @@index([submissionId])
}

// ── Affiliate partners ────────────────────────────────────────────────────
// The single place an affiliate URL is allowed to live. Previously each tool
// carried its own link, which meant a partner changing their tracking URL was a
// hunt through rows; and a link pasted into a component would be a hunt through
// code. Everything resolves through here, so switching a partner off is one
// status change rather than an edit per surface.
model Partner {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  affiliateUrl    String
  officialUrl     String
  network         String?  // Impact, Cello, direct…
  status          String   @default("active") // active | paused | ended
  disclosure      String?  // partner-specific wording, where a programme requires it
  trackingEnabled Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tools Tool[]
}

// ── Source-aware facts ────────────────────────────────────────────────────
// Every externally sourced claim carries where it came from and when it was
// last checked. Software facts rot — an integration count or a price quoted
// without a date is a liability, not social proof.
//
// `kind` keeps the four kinds of evidence apart so they can never be blended
// into one misleading number:
//   official   — the vendor's own published figure
//   community  — computed from Toolhaven reviews
//   editorial  — Toolhaven's own assessment
//   external   — a third-party review platform
model ToolFact {
  id         Int       @id @default(autoincrement())
  toolId     Int
  tool       Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  kind       String    @default("official")
  label      String    // "Integrations"
  value      String    // "3,000+"
  sourceName String?   // "Make"
  sourceUrl  String?
  verifiedAt DateTime?
  orderIndex Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([toolId, kind])
}

// ── External ratings ──────────────────────────────────────────────────────
// A rating from a third-party platform, stored with enough structure to reason
// about rather than just print. ToolFact holds strings ("3,000+"); this holds
// numbers, because confidence maths needs the count and the scale.
//
// Nothing here is ever computed from a guess. A tool with no rows shows no
// external ratings, and every consumer of this table is written to expect that.
model ExternalRating {
  id          Int      @id @default(autoincrement())
  toolId      Int
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  sourceName  String   // "G2", "Capterra", "Trustpilot"
  sourceUrl   String   // where a reader can check it themselves
  rating      Float    // as published, on that platform's own scale
  maxRating   Float    @default(5)
  reviewCount Int
  ratingDate  DateTime? // the date the platform's figure refers to, if stated
  retrievedAt DateTime  @default(now())
  summary     String?   // a short, traceable characterisation — never a quote
  orderIndex  Int       @default(0)

  @@unique([toolId, sourceName])
  @@index([toolId])
}

// ── The editorial verdict ─────────────────────────────────────────────────
// Everything on a tool page that is Toolhaven's judgement rather than the
// vendor's claim or a platform's rating. One row per tool, every field
// optional: a section with nothing in it does not render, so a half-written
// verdict looks unfinished rather than dishonest.
//
// Covers the brief's §12-§16, §23 and §24 in one place because they are all
// the same act — someone sitting down and deciding what they think — and
// splitting them across seven tables would make writing one verdict a
// seven-form job.
model ToolVerdict {
  id     Int  @id @default(autoincrement())
  toolId Int  @unique
  tool   Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  // §13 — who it fits, and who it doesn't
  bestFor     String[] // "Agencies", "Operations teams"
  notIdealFor String[] // "Anyone wanting one-click automation"

  // §14 — the same judgement in the second person, where it lands harder
  loveIf   String[] // "You need branching logic"
  regretIf String[] // "You expected to be productive in an afternoon"

  // §15 — phrased as considerations, not accusations
  costNotes String[] // "Operations are metered; heavy workflows climb tiers"

  // §16 — how hard it is to leave
  switchingCost String? // low | medium | high
  switchingNote String?

  // §12 / §23 — the vendor's positioning against what the evidence supports
  companyClaim  String?
  claimEvidence String?
  claimVerdict  String? // supported | partly-supported | unsupported | untested

  // §24
  biggestStrength String?
  biggestTradeoff String?
  valueAssessment String?
  finalVerdict    String?

  reviewedBy String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// ── Editorial alternatives ────────────────────────────────────────────────
// §19. Chosen by hand with a stated reason, because "same category, high
// popularity" is how you end up recommending a CRM to someone looking at a
// proxy provider. `reason` is the whole point: an alternative without one is
// just another link.
model ToolAlternative {
  id            Int    @id @default(autoincrement())
  toolId        Int
  tool          Tool   @relation("AlternativesFor", fields: [toolId], references: [id], onDelete: Cascade)
  alternativeId Int
  alternative   Tool   @relation("AlternativeOf", fields: [alternativeId], references: [id], onDelete: Cascade)

  // the need this alternative answers better — "Want something simpler?"
  reason     String
  orderIndex Int    @default(0)

  @@unique([toolId, alternativeId])
  @@index([toolId])
}

// ─── Pricing intelligence ────────────────────────────────────────────────
// What a tool costs, read from the vendor's own pricing page rather than typed
// in by hand. Kept in its own tables so nothing here can corrupt the editorial
// record: if extraction gets something wrong the worst case is a pricing panel
// that says it could not verify, never a wrong number on a tool page.

model ToolPricing {
  id     Int  @id @default(autoincrement())
  toolId Int  @unique
  tool   Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  // The headline figure, and everything needed to say it correctly.
  currency      String   @default("USD")
  startingPrice Float?   // null is a real answer: "we could not determine one"
  billingPeriod String?  // month | year | one-time | usage | seat
  billingType   String?  // monthly | annual | annual-billed-monthly | usage | custom
  pricingModel  String?  // free | freemium | subscription | usage | per-seat | custom | one-time
  freePlan      Boolean  @default(false)
  freeTrial     Boolean  @default(false)

  // How much this is worth trusting.
  verificationStatus String  @default("unverified") // verified | partially_verified | unverified | unavailable | custom_pricing
  confidenceScore    Float   @default(0)
  confidenceReasons  String[]

  // Where it came from, so an editor can audit any figure on the site.
  pricingUrl       String?
  sourceUrl        String?
  sourceType       String?  // official-pricing-page | official-website | structured-data
  extractionMethod String?  // json-ld | embedded-json | html-table | html-text | manual

  lastVerifiedAt     DateTime?
  lastAttemptedAt    DateTime?
  nextVerificationAt DateTime?
  consecutiveFailures Int     @default(0)

  // An editor's correction outranks the crawler and is never overwritten by it.
  isManualOverride Boolean @default(false)
  overrideNote     String?
  overriddenBy     String?

  // Held back for review when the crawler is confident enough to save but not
  // confident enough to publish. Never shown to readers.
  pendingReview Boolean @default(false)

  plans     ToolPricingPlan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextVerificationAt])
  @@index([verificationStatus])
}

model ToolPricingPlan {
  id        Int         @id @default(autoincrement())
  pricingId Int
  pricing   ToolPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  name          String
  price         Float?   // null means the plan exists but the price is not public
  currency      String   @default("USD")
  billingPeriod String   @default("month")
  billingType   String?
  isFree        Boolean  @default(false)
  isCustom      Boolean  @default(false)  // "Contact sales"
  isPopular     Boolean  @default(false)  // the vendor's own highlighted plan
  perUnit       String?  // "user" | "seat" | "1,000 operations" | "credit"
  note          String?
  rawText       String?  // the source text this plan was read from, for audit
  orderIndex    Int      @default(0)

  @@index([pricingId])
}

model ToolPricingHistory {
  id     Int  @id @default(autoincrement())
  toolId Int
  tool   Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  // A snapshot of what was true before a change, never an overwrite.
  currency      String
  startingPrice Float?
  billingPeriod String?
  pricingModel  String?
  freePlan      Boolean @default(false)
  freeTrial     Boolean @default(false)
  planSnapshot  Json?

  changeType    String  // increase | decrease | plan-added | plan-removed | free-plan-changed | currency-changed | billing-changed | first-record
  previousPrice Float?
  newPrice      Float?
  percentChange Float?
  summary       String?

  sourceUrl  String?
  detectedAt DateTime @default(now())

  @@index([toolId, detectedAt])
}

model PricingVerificationLog {
  id     Int  @id @default(autoincrement())
  toolId Int
  tool   Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  outcome     String   // success | partial | no-pricing-found | blocked | timeout | error
  sourceUrl   String?
  httpStatus  Int?
  durationMs  Int?
  method      String?
  confidence  Float?
  plansFound  Int      @default(0)
  // Operator-facing only. Never rendered to a reader; the public UI says
  // "pricing unavailable" and offers the vendor's own page.
  detail      String?
  createdAt   DateTime @default(now())

  @@index([toolId, createdAt])
  @@index([outcome])
}

// ─── Buying guides ───────────────────────────────────────────────────────
// Editorial hardware recommendations, kept deliberately separate from the tool
// index: a monitor is not software, and letting the two share a model would
// mean every tool query carrying columns about ASINs.
//
// Two rules are built into the shape of these tables. There is no field for a
// price, because Amazon's prices move hourly and a number printed here would be
// wrong within the day — the link says "check current price" and means it. And
// there is no field for a star rating or a review count, because we would be
// copying Amazon's figures without their sample, which is borrowed authority
// rather than evidence.

model BuyingGuide {
  id   Int    @id @default(autoincrement())
  slug String @unique

  title    String   // the editorial headline
  standfirst String? // the paragraph under it: what problem this solves
  intro    String?  @db.Text

  /// How these were chosen. Shown on the page, because a recommendation with
  /// no stated method is just an opinion with affiliate links attached.
  methodology String? @db.Text

  /// How many were actually considered. Entered by a person, and rendered only
  /// when set — a fabricated "we tested 47 monitors" is exactly the kind of
  /// borrowed credibility this whole section is meant to avoid.
  productsConsidered Int?

  finalWord String? @db.Text

  status      String    @default("draft") // draft | published
  publishedAt DateTime?

  // SEO. Falls back to the editorial fields when left blank, so a guide is
  // never published with an empty title tag.
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageId       Int?
  ogImage         Upload?  @relation("GuideOgImage", fields: [ogImageId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  picks GuidePick[]
  faqs  GuideFaq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

/// One recommended product inside a guide.
model GuidePick {
  id      Int         @id @default(autoincrement())
  guideId Int
  guide   BuyingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  /// "Best overall", "Best budget", "Best for colour work". Free text rather
  /// than an enum: the useful award is the one that describes this guide's
  /// actual shape, not one of five we guessed in advance.
  award String?

  name  String
  brand String?
  model String?

  imageId  Int?
  image    Upload? @relation("GuidePickImage", fields: [imageId], references: [id])
  imageAlt String?

  /// Every photo for this pick, in the order they are shown. The first is the
  /// lead image and is mirrored into imageId above, so anything still reading a
  /// single image keeps working while this rolls out.
  photos GuidePickPhoto[]

  /// The editorial line. Ours, in our voice, and the reason the pick is here.
  verdict     String? @db.Text
  bestFor     String?
  /// The honest counterweight — who should buy something else instead.
  considerElseIf String?

  /// Label/value pairs, ordered, as [{ label, value }].
  specs Json?

  pros String[]
  cons String[]

  /// The Amazon Associates link. Stored once, here, and the only outbound
  /// commercial link on the page.
  amazonUrl String?
  asin      String?

  reviewedAt DateTime?
  orderIndex Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guideId, orderIndex])
}

/// One photo on one pick.
///
/// A join model rather than an array of upload ids on the pick: a photo carries
/// its own alt text and its own position, and an Int[] has nowhere to put
/// either. Deleting a pick takes its photos with it. Deleting the underlying
/// upload is restricted, because those bytes are de-duplicated by hash and may
/// still be in use by another pick.
model GuidePickPhoto {
  id       Int       @id @default(autoincrement())
  pickId   Int
  pick     GuidePick @relation(fields: [pickId], references: [id], onDelete: Cascade)
  uploadId Int
  upload   Upload    @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  /// What the photo shows. Blank is allowed and means decorative; it is not
  /// auto-filled with the product name, which would have a screen reader
  /// announce the same words six times down a single pick.
  alt      String?
  position Int       @default(0)

  createdAt DateTime @default(now())

  @@index([pickId, position])
}

model GuideFaq {
  id      Int         @id @default(autoincrement())
  guideId Int
  guide   BuyingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  question   String
  answer     String @db.Text
  orderIndex Int    @default(0)

  @@index([guideId, orderIndex])
}
